# Copy to .env (gitignored). Leave AUTH_MODE=local for a single-user install on your own machine.
AUTH_MODE=local

# Google sign-in (AUTH_MODE=google). The server refuses to start if any of these is missing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_SECRET=          # openssl rand -base64 32
BETTER_AUTH_URL=http://127.0.0.1:8090
ALLOWED_EMAILS=              # comma-separated; empty = anyone with a Google account

# Feedback loop (optional)
# Admin API for you and your agents (npm run feedback). Generate: openssl rand -hex 24
FEEDBACK_ADMIN_TOKEN=
# Mirror each report to a GitHub issue (leave OFF until you've reviewed what reports contain):
# fine-grained token with "Issues: read and write" on this repo only
GITHUB_TOKEN=
GITHUB_REPO=
